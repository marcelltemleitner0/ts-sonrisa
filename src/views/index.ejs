<!DOCTYPE html>
<html lang="en" class="h-full bg-white">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="h-full flex flex-col items-center justify-center px-4 sm:px-6 lg:px-8 text-black antialiased">

    <div class="w-full max-w-md space-y-8 border border-black p-8 sm:p-10 bg-white shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">

        <div>
            <h1 class="text-2xl font-bold uppercase tracking-wider text-center">
                <%= message %>
            </h1>
        </div>

        <div class="flex flex-col gap-4">

            <a
                href="/reservation"
                class="block w-full bg-black text-white py-3 px-4 font-mono text-sm uppercase tracking-wider font-bold text-center hover:bg-gray-900 active:bg-gray-800 transition-all duration-150"
            >
                Make a Reservation
            </a>

            <a
                href="/register"
                class="block w-full bg-white text-black py-3 px-4 font-mono text-sm uppercase tracking-wider font-bold text-center border border-black hover:bg-black hover:text-white transition-all duration-150"
            >
                Create an Account
            </a>

        </div>

    </div>

</body>
</html>
